{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyy--localmate",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "localmate-db",
      "database_id": "2c719513-1cb3-46ec-98f6-a7443d859c6e"
    }
  ]
}
