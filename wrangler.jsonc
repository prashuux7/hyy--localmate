{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyy--localmate",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "localmate-db",
      "database_id": "5231f7d3-9963-4e9f-8265-10a9802f2c3b"
    }
  ]
}
